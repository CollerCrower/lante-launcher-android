@@ -0,0 +1,35 @@
+package com.movtery.zalithlauncher.lante
+
+/**
+ * Lante Network'e özel ayarlar (Lante Launcher — Zalith Launcher 2'nin resmî olmayan değiştirilmiş sürümü).
+ * Sunucu veya site adresi değişirse SADECE burayı düzenle.
+ */
+object LanteConfig {
+    /** "Lante'ye Gir" düğmesinin oyunu açıp doğrudan bağlandığı sunucu */
+    const val SERVER_ADDRESS = "oyna.lantenetwork.com"
+
+    /** Uygulama içi site görünümünün açıldığı ana adres */
+    const val SITE_URL = "https://lantenetwork.com"
+
+    /** Uygulama içi görünümde açılmasına izin verilen alan adları (ödeme için Shopier dahil) */
+    fun isAllowedHost(host: String?): Boolean {
+        val h = host?.lowercase() ?: return false
+        return h == "lantenetwork.com" || h.endsWith(".lantenetwork.com") ||
+            h == "shopier.com" || h.endsWith(".shopier.com")
+    }
+
+    /**
+     * Zalith'in kendi güncelleme kontrolü ORİJİNAL Zalith sürümlerine bakar. Lante sürümünde
+     * kullanıcıya yanlışlıkla orijinal uygulamayı önermesin diye KAPALI. Kendi güncelleme
+     * sistemini kurduğunda (ör. site /launcher/api/version) true yapıp LauncherUpgradeViewModel'i
+     * kendi adresine yönlendir.
+     */
+    const val UPSTREAM_UPDATE_CHECK = false
+
+    /**
+     * ZALITH LAUNCHER 2 LİSANS KOŞULU (GPL-3.0 §7): değiştirilmiş sürümün ana ekranında
+     * "Resmî olmayan değiştirilmiş sürüm" ifadesi AÇIKÇA görünmelidir. Bu metni kaldırma.
+     */
+    const val UNOFFICIAL_NOTICE =
+        "Resmî olmayan değiştirilmiş sürüm · Zalith Launcher 2 tabanlı · GPL-3.0"
+}
