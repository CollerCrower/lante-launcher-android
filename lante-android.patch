diff --git a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/lante/LanteApi.kt b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/lante/LanteApi.kt
new file mode 100644
index 0000000..0808bc3
--- /dev/null
+++ b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/lante/LanteApi.kt
@@ -0,0 +1,192 @@
+package com.movtery.zalithlauncher.lante
+
+import android.webkit.CookieManager
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import java.util.concurrent.TimeUnit
+
+/**
+ * Lante Network site API'si (Android). Oturum çerezleri sistemin CookieManager'ında tutulur:
+ * böylece aynı giriş hem buradaki çark ekranında hem de uygulama içi site görünümünde (WebView) geçerlidir.
+ * Şifre hiçbir yerde SAKLANMAZ.
+ */
+object LanteApi {
+    private val client by lazy {
+        OkHttpClient.Builder()
+            .connectTimeout(15, TimeUnit.SECONDS)
+            .readTimeout(25, TimeUnit.SECONDS)
+            .build()
+    }
+    private val json = Json { ignoreUnknownKeys = true; isLenient = true; coerceInputValues = true }
+    private val JSON_MEDIA = "application/json; charset=utf-8".toMediaType()
+    private const val UA = "LanteLauncherAndroid"
+
+    class ApiException(val status: Int, message: String) : Exception(message)
+
+    /* ───────── Modeller ───────── */
+    @Serializable private data class LoginBody(val username: String, val password: String)
+    @Serializable private data class Verify2faBody(val pendingToken: String, val code: String)
+    @Serializable private data class SpinBody(val count: Int)
+    @Serializable data class LoginUser(val username: String? = null)
+    @Serializable data class LoginResponse(
+        val success: Boolean = false,
+        val requires2FA: Boolean = false,
+        val pendingToken: String? = null,
+        val message: String? = null,
+        val error: String? = null,
+        val user: LoginUser? = null
+    )
+
+    sealed interface LoginResult {
+        data class Success(val username: String) : LoginResult
+        data class Needs2FA(val pendingToken: String) : LoginResult
+        data class Failure(val message: String) : LoginResult
+    }
+
+    @Serializable data class WheelPrize(
+        val id: Int = 0,
+        val label: String = "",
+        val description: String? = null,
+        val rarity: String = "common",
+        val icon: String = "🎁",
+        val chance: Double = 0.0,
+        val type: String = "credits"
+    )
+    @Serializable data class WheelData(
+        val enabled: Boolean = true,
+        val balance: Int = 0,
+        val earnedTotal: Int = 0,
+        val usedTotal: Int = 0,
+        val depositTl: Double = 0.0,
+        val tlPerSpin: Double = 25.0,
+        val nextSpinInTl: Double = 0.0,
+        val progressPct: Int = 0,
+        val prizes: List<WheelPrize> = emptyList()
+    )
+    @Serializable data class SpinItem(val spinId: Long = 0, val prize: WheelPrize = WheelPrize())
+    @Serializable data class SpinResponse(
+        val success: Boolean = false,
+        val results: List<SpinItem> = emptyList(),
+        val balance: Int = 0,
+        val error: String? = null
+    )
+    @Serializable data class UpdateInfo(val version: String = "", val apkUrl: String = "", val notes: String? = null)
+
+    /* ───────── Çerez yardımcıları (CookieManager ana iş parçacığında çağrılır) ───────── */
+    private suspend fun saveCookies(headers: List<String>) = withContext(Dispatchers.Main) {
+        val cm = CookieManager.getInstance()
+        cm.setAcceptCookie(true)
+        headers.forEach { cm.setCookie(LanteConfig.SITE_URL, it) }
+        cm.flush()
+    }
+
+    private suspend fun cookieHeader(): String? = withContext(Dispatchers.Main) {
+        CookieManager.getInstance().getCookie(LanteConfig.SITE_URL)
+    }
+
+    /** Oturum çerezi var mı? (geçerliliğini sunucu belirler) */
+    suspend fun hasSession(): Boolean = cookieHeader()?.contains("lante_session") == true
+
+    suspend fun logout() = withContext(Dispatchers.Main) {
+        val cm = CookieManager.getInstance()
+        cm.removeAllCookies(null)
+        cm.flush()
+    }
+
+    /* ───────── HTTP ───────── */
+    private class RawResponse(val code: Int, val body: String, val setCookies: List<String>)
+
+    private suspend fun call(request: Request): Pair<Int, String> {
+        val raw = withContext(Dispatchers.IO) {
+            val resp = client.newCall(request).execute()
+            try {
+                RawResponse(resp.code, resp.body?.string().orEmpty(), resp.headers("Set-Cookie"))
+            } finally {
+                resp.close()
+            }
+        }
+        if (raw.setCookies.isNotEmpty()) saveCookies(raw.setCookies)
+        return raw.code to raw.body
+    }
+
+    private fun base(path: String) = Request.Builder().url(LanteConfig.SITE_URL + path).header("User-Agent", UA)
+
+    private suspend fun post(path: String, bodyJson: String, withSession: Boolean = false): Pair<Int, String> {
+        val b = base(path).header("Content-Type", "application/json").post(bodyJson.toRequestBody(JSON_MEDIA))
+        if (withSession) cookieHeader()?.let { b.header("Cookie", it) }
+        return call(b.build())
+    }
+
+    private suspend fun get(path: String, withSession: Boolean): Pair<Int, String> {
+        val b = base(path).get()
+        if (withSession) cookieHeader()?.let { b.header("Cookie", it) }
+        return call(b.build())
+    }
+
+    private fun parseLogin(code: Int, body: String, fallbackUser: String): LoginResult {
+        val r = runCatching { json.decodeFromString<LoginResponse>(body) }.getOrNull()
+        if (r == null) return LoginResult.Failure("Sunucudan beklenmeyen cevap (HTTP $code)")
+        val token = r.pendingToken
+        val canonical = r.user?.username
+        return when {
+            r.requires2FA && token != null && token.isNotBlank() -> LoginResult.Needs2FA(token)
+            r.success -> LoginResult.Success(if (canonical != null && canonical.isNotBlank()) canonical else fallbackUser)
+            code == 429 -> LoginResult.Failure("Çok fazla deneme. Biraz bekleyip tekrar dene.")
+            else -> LoginResult.Failure(r.message ?: r.error ?: "Giriş başarısız (HTTP $code)")
+        }
+    }
+
+    /* ───────── Giriş ───────── */
+    suspend fun login(username: String, password: String): LoginResult = runCatching {
+        val (code, body) = post("/api/auth/login", json.encodeToString(LoginBody(username.trim(), password)))
+        parseLogin(code, body, username.trim())
+    }.getOrElse { LoginResult.Failure("Sunucuya ulaşılamadı: ${it.message ?: it::class.simpleName}") }
+
+    suspend fun verify2fa(pendingToken: String, code: String, fallbackUser: String): LoginResult = runCatching {
+        val (status, body) = post("/api/auth/verify-2fa", json.encodeToString(Verify2faBody(pendingToken, code.trim())))
+        parseLogin(status, body, fallbackUser)
+    }.getOrElse { LoginResult.Failure("Sunucuya ulaşılamadı: ${it.message ?: it::class.simpleName}") }
+
+    /* ───────── Yükleme çarkı ───────── */
+    suspend fun wheel(): WheelData {
+        val (code, body) = get("/api/wheel", withSession = true)
+        if (code == 401) throw ApiException(401, "Önce Lante hesabınla giriş yap.")
+        if (code != 200) throw ApiException(code, runCatching { json.decodeFromString<SpinResponse>(body).error }.getOrNull() ?: "Çark yüklenemedi (HTTP $code)")
+        return json.decodeFromString<WheelData>(body)
+    }
+
+    suspend fun spin(count: Int): SpinResponse {
+        val (code, body) = post("/api/wheel", json.encodeToString(SpinBody(count)), withSession = true)
+        if (code == 401) throw ApiException(401, "Oturumun süresi dolmuş, tekrar giriş yap.")
+        val r = runCatching { json.decodeFromString<SpinResponse>(body) }.getOrNull()
+            ?: throw ApiException(code, "Beklenmeyen cevap (HTTP $code)")
+        if (code != 200 || !r.success) throw ApiException(code, r.error ?: "Çevirme başarısız (HTTP $code)")
+        return r
+    }
+
+    /* ───────── Güncelleme ───────── */
+    suspend fun fetchUpdate(): UpdateInfo? = runCatching {
+        val (code, body) = get("/downloads/android-version.json", withSession = false)
+        if (code == 200) json.decodeFromString<UpdateInfo>(body) else null
+    }.getOrNull()
+
+    /** "2.6.1-lante.2" gibi sürümleri sayı dizisi olarak karşılaştırır: remote > local ise true */
+    fun isNewer(remote: String, local: String): Boolean {
+        fun parts(v: String) = Regex("\\d+").findAll(v).map { it.value.toLong() }.toList()
+        val r = parts(remote)
+        val l = parts(local)
+        for (i in 0 until maxOf(r.size, l.size)) {
+            val a = r.getOrElse(i) { 0L }
+            val b = l.getOrElse(i) { 0L }
+            if (a != b) return a > b
+        }
+        return false
+    }
+}
diff --git a/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/lante/LanteConfig.kt b/ZalithLauncher/src/main/java/com/movtery/zalithlauncher/lante/LanteConfig.kt
