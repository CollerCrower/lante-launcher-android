+import com.movtery.zalithlauncher.game.account.AccountType
+import com.movtery.zalithlauncher.game.account.AccountsManager
+import com.movtery.zalithlauncher.game.account.localLogin
+import com.movtery.zalithlauncher.lante.LanteApi
+import kotlinx.coroutines.launch
+
+/**
+ * Lante hesabıyla giriş (site hesabı). Başarılı olunca:
+ *  • site oturumu çerezleri kaydedilir (çark + uygulama içi site görünümü hemen çalışır),
+ *  • oyun için aynı adda bir YEREL hesap eklenir (zaten varsa yenisi eklenmez).
+ *
+ * NOT (Zalith kuralı): Çin anakarası dışında, yerel hesabın oyunu başlatabilmesi için launcher'da
+ * satın alınmış bir Microsoft hesabının da ekli olması gerekir. Bu kural bu sürümde AYNEN korunur.
+ */
+@Composable
+fun LanteLoginDialog(
+    onDismiss: () -> Unit,
+    onLoggedIn: (String) -> Unit = {}
+) {
+    val scope = rememberCoroutineScope()
+    var username by remember { mutableStateOf("") }
+    var password by remember { mutableStateOf("") }
+    var code by remember { mutableStateOf("") }
+    var pendingToken by remember { mutableStateOf<String?>(null) }
+    var busy by remember { mutableStateOf(false) }
+    var message by remember { mutableStateOf<String?>(null) }
+
+    fun finish(name: String) {
+        val exists = AccountsManager.accountsFlow.value.any { it.username.equals(name, ignoreCase = true) && it.accountType == AccountType.LOCAL.tag }
+        if (!exists) localLogin(name, null)
+        onLoggedIn(name)
+        onDismiss()
+    }
+
+    AlertDialog(
+        onDismissRequest = { if (!busy) onDismiss() },
+        title = { Text("Lante hesabı") },
+        text = {
+            Column {
+                if (pendingToken == null) {
+                    Text("Sitedeki kullanıcı adın ve şifrenle giriş yap.", style = MaterialTheme.typography.bodySmall)
+                    OutlinedTextField(
+                        modifier = Modifier.fillMaxWidth().padding(top = 10.dp),
+                        value = username, onValueChange = { username = it.take(16) },
+                        singleLine = true, label = { Text("Kullanıcı adı") }
+                    )
+                    OutlinedTextField(
+                        modifier = Modifier.fillMaxWidth().padding(top = 8.dp),
+                        value = password, onValueChange = { password = it },
+                        singleLine = true, label = { Text("Şifre") },
+                        visualTransformation = PasswordVisualTransformation(),
+                        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Password)
+                    )
+                } else {
+                    Text("İki adımlı doğrulama: kimlik doğrulayıcı uygulamandaki 6 haneli kodu gir.", style = MaterialTheme.typography.bodySmall)
+                    OutlinedTextField(
+                        modifier = Modifier.fillMaxWidth().padding(top = 10.dp),
+                        value = code, onValueChange = { code = it.filter(Char::isDigit).take(6) },
+                        singleLine = true, label = { Text("Doğrulama kodu") },
+                        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.NumberPassword)
+                    )
+                }
+                message?.let {
+                    Text(it, color = MaterialTheme.colorScheme.error, style = MaterialTheme.typography.bodySmall, modifier = Modifier.padding(top = 8.dp))
+                }
+                Text(
+                    "Şifren cihazda saklanmaz.",
+                    style = MaterialTheme.typography.labelSmall,
+                    modifier = Modifier.padding(top = 8.dp)
+                )
+            }
+        },
+        confirmButton = {
+            TextButton(
+                enabled = !busy && ((pendingToken == null && username.isNotBlank() && password.isNotEmpty()) || (pendingToken != null && code.length == 6)),
+                onClick = {
+                    busy = true
+                    message = null
+                    scope.launch {
+                        val token = pendingToken
+                        val result = if (token == null) LanteApi.login(username, password) else LanteApi.verify2fa(token, code, username.trim())
+                        busy = false
+                        password = ""
+                        when (result) {
+                            is LanteApi.LoginResult.Success -> finish(result.username)
+                            is LanteApi.LoginResult.Needs2FA -> { pendingToken = result.pendingToken; code = "" }
+                            is LanteApi.LoginResult.Failure -> { message = result.message; code = "" }
+                        }
+                    }
+                }
+            ) { Text(if (busy) "Bekle…" else if (pendingToken == null) "Giriş yap" else "Doğrula") }
+        },
+        dismissButton = { TextButton(enabled = !busy, onClick = onDismiss) { Text("Vazgeç") } }
+    )
+}
